          "body": "<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\nhtml{font-size:16px;-webkit-text-size-adjust:100%}\nbody{background:#f5efe6;color:#2a2421;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;line-height:1.75;font-size:1rem;padding-bottom:4.5rem}\nmain{display:block}\na{color:inherit;text-decoration:none}\n\n/* hero: 全宽色带分层堆叠 */\n.hero{position:relative;overflow:hidden;background:#e8dfd0}\n.hero-band{display:block;width:100%;padding:1.75rem 6vw}\n.hero-band--ink{background:#2a2421;color:#f5efe6}\n.hero-band--cream{background:#f5efe6;color:#2a2421}\n.hero-band--brick{background:#a8442a;color:#f5efe6}\n.hero-band--cream-dark{background:#e8dfd0;color:#2a2421}\n.hero-band h1{font-size:clamp(2.6rem,9vw,5.4rem);line-height:1.02;letter-spacing:-0.02em;font-weight:800}\n.hero-band--ink h1,.hero-band--brick h1{font-weight:800}\n.hero-band p{font-size:clamp(0.95rem,2.2vw,1.1rem);max-width:46ch;margin-top:0.6rem;line-height:1.6;font-weight:400}\n.hero-band--brick p{color:#f5efe6;opacity:0.92}\n.hero-band--ink .lede{max-width:54ch;font-size:clamp(1rem,2.4vw,1.18rem);line-height:1.7;margin-top:0.8rem;color:#e8dfd0}\n.hero-band--cream-dark .lede{max-width:58ch;font-size:clamp(1rem,2.4vw,1.18rem);line-height:1.7;margin-top:0.6rem;color:#2a2421}\n.hero-meta{display:flex;flex-wrap:wrap;gap:1.2rem 2rem;margin-top:1rem;font-size:0.82rem;letter-spacing:0.04em}\n.hero-meta span{position:relative;padding-left:1.1rem}\n.hero-meta span::before{content:\"\";position:absolute;left:0;top:0.5em;width:0.5rem;height:0.5rem;background:currentColor;opacity:0.65}\n\n/* 通用区块 */\n.section{padding:5rem 6vw}\n.section--tight{padding:3.5rem 6vw}\n.eyebrow{font-size:0.78rem;letter-spacing:0.2em;text-transform:uppercase;color:#a8442a;margin-bottom:1.2rem;font-weight:600}\nh2{font-size:clamp(1.8rem,4.6vw,2.8rem);line-height:1.15;letter-spacing:-0.01em;font-weight:700;margin-bottom:1.6rem}\nh3{font-size:1.18rem;font-weight:600;margin-bottom:0.6rem;line-height:1.4}\np{margin-bottom:1rem;max-width:64ch}\n\n/* 卡片：左侧色条标记 */\n.cards{display:grid;gap:1.4rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}\n.card{position:relative;background:#f5efe6;border:1px solid rgba(168,68,42,0.18);padding:1.6rem 1.6rem 1.6rem 2rem;border-radius:6px}\n.card::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:6px;background:#a8442a}\n.card h3{color:#a8442a;font-size:1.1rem}\n.card p{font-size:0.95rem;color:#3d342e;line-height:1.65}\n\n/* 套餐：纵向列表逐行展开 */\n.plans-list{list-style:none;border-top:2px solid #2a2421}\n.plan{display:grid;grid-template-columns:1fr;gap:0.4rem;padding:2rem 0;border-bottom:1px solid rgba(42,36,33,0.16)}\n.plan-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:0.5rem}\n.plan-name{font-size:1.5rem;font-weight:700;letter-spacing:-0.01em}\n.plan-name .badge{display:inline-block;margin-left:0.5rem;padding:0.15rem 0.5rem;background:#a8442a;color:#f5efe6;font-size:0.72rem;border-radius:3px;vertical-align:middle;letter-spacing:0.06em;font-weight:600}\n.plan-price{font-size:1.2rem;color:#a8442a;font-weight:600}\n.plan-annual{font-size:0.88rem;color:#6d605a;margin-bottom:0.4rem}\n.plan-features{list-style:none;display:grid;gap:0.45rem;margin-top:0.8rem;max-width:64ch}\n.plan-features li{position:relative;padding-left:1.4rem;font-size:0.95rem;line-height:1.6;color:#2a2421}\n.plan-features li::before{content:\"—\";position:absolute;left:0;color:#a8442a;font-weight:600}\n.plan-note{margin-top:1rem;font-size:0.82rem;color:#6d605a;max-width:64ch;line-height:1.6}\n\n/* 客户端 */\n.clients{display:grid;gap:1.2rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}\n.client{padding:1.4rem 1.6rem;background:#f5efe6;border:1px solid rgba(42,36,33,0.14);border-radius:6px}\n.client h3{color:#a8442a;font-size:1.05rem;margin-bottom:0.3rem}\n.client p{font-size:0.9rem;line-height:1.6;margin-bottom:0.5rem}\n.client .tag{display:inline-block;font-size:0.75rem;color:#6d605a;border:1px solid rgba(42,36,33,0.2);padding:0.15rem 0.5rem;border-radius:3px}\n.client .link{display:inline-block;margin-top:0.5rem;font-size:0.85rem;color:#a8442a;font-weight:600}\n\n/* FAQ：编号列表 */\n.faq{counter-reset:faq;list-style:none;display:grid;gap:1.4rem}\n.faq-item{counter-increment:faq;position:relative;padding-left:3.2rem}\n.faq-item::before{content:counter(faq,decimal-leading-zero);position:absolute;left:0;top:0.05rem;font-size:1.3rem;font-weight:700;color:#a8442a;font-variant-numeric:tabular-nums}\n.faq-item h3{font-size:1.08rem;font-weight:600;margin-bottom:0.5rem;line-height:1.45}\n.faq-item p{font-size:0.95rem;line-height:1.7;color:#3d342e}\n\n/* 导航：底部固定式文字导航 */\n.navbar{position:fixed;left:0;right:0;bottom:0;background:#2a2421;color:#e8dfd0;padding:0.9rem 6vw;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:0.8rem;z-index:50;font-size:0.85rem;border-top:3px solid #a8442a}\n.navbar-brand{font-weight:700;letter-spacing:0.04em}\n.navbar-links{display:flex;flex-wrap:wrap;gap:1.2rem}\n.navbar-links a{color:#e8dfd0;opacity:0.85;transition:opacity 0.15s}\n.navbar-links a:hover{opacity:1;color:#f5efe6}\n\n/* 使用说明步骤 */\n.steps{counter-reset:step;list-style:none;display:grid;gap:1.2rem}\n.steps li{counter-increment:step;position:relative;padding-left:3rem;min-height:2rem}\n.steps li::before{content:counter(step);position:absolute;left:0;top:0;width:2rem;height:2rem;background:#a8442a;color:#f5efe6;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.95rem}\n.steps h3{margin-bottom:0.3rem}\n.steps p{font-size:0.95rem;line-height:1.65;margin-bottom:0}\n\n/* 响应式微调 */\n@media (min-width:768px){.plan{grid-template-columns:1.4fr 1fr;gap:1.5rem 2rem;align-items:start}\n  .plan-features{grid-column:2}\n  .plan-note{grid-column:1 / -1}}\n@media (max-width:600px){\n  .hero-band{padding:1.3rem 6vw}\n  .section{padding:3.5rem 6vw}\n  .navbar{font-size:0.78rem;gap:0.5rem}\n  .navbar-links{gap:0.8rem}\n}\n</style><main>\n  <header class=\"hero\">\n    <div class=\"hero-band hero-band--ink\">\n      <h1>GoCats</h1>\n      <p class=\"lede\">一只游走在墙头与楼宇之间的网络猫，替你把被拧紧的线路，松成一条可以晒太阳的尾巴。</p>\n    </div>\n    <div class=\"hero-band hero-band--cream\">\n      <p>这里的工程日志，更像一本关于猫如何翻墙的随笔：它不声称跑得最快，只在乎每一次落地是否轻巧。</p>\n    </div>\n    <div class=\"hero-band hero-band--brick\">\n      <p>本页所述功能、价格与节点策略，均以 GoCats 当前公开说明为准；我们不替任何第三方协议背书，也不承诺无法被验证的隐私神话。</p>\n    </div>\n    <div class=\"hero-band hero-band--cream-dark\">\n      <div class=\"hero-meta\">\n        <span>三档方案，按月或按年</span>\n        <span>原生流媒体友好</span>\n        <span>IPLC 专线可选</span>\n        <span>无日志承诺，仅限技术层面</span>\n      </div>\n    </div>\n  </header>\n\n  <section class=\"section\">\n    <div class=\"eyebrow\">写在前面</div>\n    <h2>不是所有翻墙，都需要一声巨响</h2>\n    <p>GoCats 的名字来自一个很朴素的观察：猫从来不为翻墙这件事做动员，它只是在某个午后的窗台上伸了个懒腰，然后轻巧地落到了另一边。我们把这种姿态，放进了网络线路的调度里。</p>\n    <p>这意味着我们不会在首页堆满“极速”“秒开”“全球节点覆盖两百国”这类无从验证的形容词。线路是租来的，带宽是有限的，协议是公开的，猫也是会打盹的。我们更愿意告诉你：每月 100GB 的基础流量，足够让一个人在通勤路上把订阅列表刷完，再看两部老电影；300GB 的旗舰档，则能撑起一家三口各自抱着平板追剧的夜晚。</p>\n    <p>如果你愿意把网络托付给一只猫，那接下来的文字，就是它的饲养手册。</p>\n  </section>\n\n  <section class=\"section section--tight\">\n    <div class=\"eyebrow\">它能做什么</div>\n    <h2>三个方向，够了</h2>\n    <div class=\"cards\">\n      <article class=\"card\">\n        <h3>让网页先抵达，再说话</h3>\n        <p>GoCats 的线路调度优先保障首屏加载与 API 响应，而不是一味追求测速数字。对日常浏览、文档协同和即时通讯而言，延迟的稳定性比峰值带宽更影响体感。</p>\n      </article>\n      <article class=\"card\">\n        <h3>对流媒体保持友好</h3>\n        <p>旗舰版与团队版标注了“原生流媒体解锁”，指的是我们在部分节点上尽量使出口 IP 与服务方预期的地区一致，以减少被识别为代理的概率。这不等于永久保证，平台策略随时可能变动。</p>\n      </article>\n      <article class=\"card\">\n        <h3>给游戏留一条专线</h3>\n        <p>旗舰版及以上包含 IPLC 专线加速优化，主要面向跨境延迟敏感的场景，如海外游戏联机、远程桌面与实时直播。专线带宽有限，按公平使用原则调度。</p>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"eyebrow\">方案与价格</div>\n    <h2>三只猫，三种吃法</h2>\n    <p>下列方案均为 GoCats 当前公开的订阅档位。月付价格与年付折后价格已写明，所有流量均为“极速流量池”配额，超出后通常仍可使用，但速率会被调低至保障通道水平，不会断流。</p>\n    <ol class=\"plans-list\">\n      <li class=\"plan\">\n        <div>\n          <div class=\"plan-head\"><span class=\"plan-name\">基础版</span><span class=\"plan-price\">¥15 / 月</span></div>\n          <div class=\"plan-annual\">按年付仅需 ¥150 / 年，相当于免两月</div>\n          <p>适合一个人、一台电脑加一部手机，把早晨的资讯和晚上的剧都装下。</p>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <p class=\"plan-note\">基础版不包含专线与原生解锁，节点池按区域轮换，遇高峰可能需要手动切换。适合预算有限、使用场景集中在浏览与轻度视频的用户。</p>\n      </li>\n      <li class=\"plan\">\n        <div>\n          <div class=\"plan-head\"><span class=\"plan-name\">旗舰版<span class=\"badge\">推荐</span></span><span class=\"plan-price\">¥35 / 月</span></div>\n          <div class=\"plan-annual\">按年付仅需 ¥350 / 年，相当于免两月</div>\n          <p>大多数家庭的选择，流媒体、游戏、远程办公都能覆盖。</p>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n        <p class=\"plan-note\">旗舰版是 GoCats 主要维护的档位，新节点与协议升级通常会优先在此上线。专线资源按会话调度，长时间高带宽占用可能触发公平使用提示。</p>\n      </li>\n      <li class=\"plan\">\n        <div>\n          <div class=\"plan-head\"><span class=\"plan-name\">团队版</span><span class=\"plan-price\">¥85 / 月</span></div>\n          <div class=\"plan-annual\">按年付仅需 ¥850 / 年，相当于免两月</div>\n          <p>为小组、工作室与小公司准备，带专属出口与客户经理。</p>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <p class=\"plan-note\">团队版的定制路由需提供合规用途说明，我们不接受用于违反所在地法律或服务条款的流量模式。客户经理响应时间为工作时段两小时内。</p>\n      </li>\n    </ol>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"eyebrow\">客户端</div>\n    <h2>猫的四个爪子</h2>\n    <p>GoCats 不单独发售客户端，订阅任意档位后，可使用以下通用工具接入。配置信息会随开通邮件一并送达，复制到对应应用即可。</p>\n    <div class=\"clients\">\n      <article class=\"client\">\n        <h3>Windows · v2rayN</h3>\n        <p>开源桌面客户端，支持订阅链接批量导入，适合旗舰版与团队版多设备场景。</p>\n        <span class=\"tag\">Win 10 及以上</span>\n        <a class=\"link\" href=\"#\">查看配置说明 →</a>\n      </article>\n      <article class=\"client\">\n        <h3>macOS · ClashX</h3>\n        <p>菜单栏常驻型客户端，规则灵活，可按域名分流，适合需要精细路由的进阶用户。</p>\n        <span class=\"tag\">macOS 11 及以上</span>\n        <a class=\"link\" href=\"#\">查看配置说明 →</a>\n      </article>\n      <article class=\"client\">\n        <h3>Android · v2rayNG</h3>\n        <p>移动端常用接入工具，支持分应用代理与按需唤醒，基础版用户的主力选择。</p>\n        <span class=\"tag\">Android 9 及以上</span>\n        <a class=\"link\" href=\"#\">查看配置说明 →</a>\n      </article>\n      <article class=\"client\">\n        <h3>iOS · Shadowrocket</h3>\n        <p>App Store 付费应用，需自行购买。GoCats 提供适配该应用的订阅地址。</p>\n        <span class=\"tag\">iOS 15 及以上</span>\n        <a class=\"link\" href=\"#\">查看配置说明 →</a>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"eyebrow\">使用说明</div>\n    <h2>四步，把猫领回家</h2>\n    <ol class=\"steps\">\n      <li>\n        <h3>选择一档方案</h3>\n        <p>从基础版、旗舰版、团队版中选一个与你的使用强度匹配的档位。月付用于试用，年付更适合已经决定长期使用的人。</p>\n      </li>\n      <li>\n        <h3>完成订阅与开通</h3>\n        <p>付款后系统通常在几分钟内开通，订阅地址与节点列表会通过邮件发送。若超过 30 分钟未收到，请先检查垃圾箱，再提交工单。</p>\n      </li>\n      <li>\n        <h3>导入客户端</h3>\n        <p>在对应平台的客户端中粘贴订阅链接，更新节点列表。首次使用建议手动选择一个延迟较低的节点，再开启全局或分流模式。</p>\n      </li>\n      <li>\n        <h3>按需调整，保持安静</h3>\n        <p>GoCats 的线路会不定期维护与扩容，客户端会随订阅更新自动获取。无需频繁手动干预，像猫一样，放着就好。</p>\n      </li>\n    </ol>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"eyebrow\">常见问题</div>\n    <h2>猫偶尔也会被问到的几件事</h2>\n    <ol class=\"faq\">\n      <li class=\"faq-item\">\n        <h3>GoCats 是否承诺“绝不日志”？</h3>\n        <p>我们不记录用户的浏览内容、DNS 查询与访问目标。但在技术层面，会保留连接时间与流量统计，用于计费与故障排查。这是当前所有按流量计费服务的客观需要，与营销话术无关。</p>\n      </li>\n      <li class=\"faq-item\">\n        <h3>流量用完之后会断网吗？</h3>\n        <p>不会立刻断开。当月极速流量耗尽后，连接仍可保持，但速率会被调低至保障通道水平，通常足够收发邮件与文字浏览，不适合视频与大文件下载。</p>\n      </li>\n      <li class=\"faq-item\">\n        <h3>为什么有时节点延迟比宣传的高？</h3>\n        <p>节点延迟受本地运营商、跨境路由与目标服务器共同影响，首页与测速截图通常是在最优条件下取得的参考值。GoCats 不把单次测速作为服务质量承诺，建议以连续三日的使用体感为准。</p>\n      </li>\n      <li class=\"faq-item\">\n        <h3>可以同时用多少台设备？</h3>\n        <p>基础版 3 台、旗舰版 5 台、团队版 20 台。同一订阅地址在超出限额后，新连接会把旧连接挤下线，不会产生额外费用，但会导致设备频繁掉线，建议按需配置。</p>\n      </li>\n      <li class=\"faq-item\">\n        <h3>订阅后可以退款吗？</h3>\n        <p>GoCats 目前不提供无理由退款。若开通后 24 小内因节点不可用导致完全无法连接，可凭工单与日志截图申请等额流量补偿或方案调整，不退还现金。</p>\n      </li>\n      <li class=\"faq-item\">\n        <h3>GoCats 适合用来做什么？</h3>\n        <p>日常浏览、跨境文档协同、海外流媒体观看、远程办公与游戏联机，是 GoCats 的主要设计场景。我们不承诺、也不鼓励用于任何违反所在地法律或目标服务条款的用途。</p>\n      </li>\n    </ol>\n  </section>\n\n  <section class=\"section section--tight\">\n    <div class=\"eyebrow\">关于这只猫</div>\n    <h2>它不替你决定去哪，只负责让你到得了</h2>\n    <p>GoCats 由一支小型运维与协议开发团队维护，节点分布以亚太与北美为主，欧洲节点按需补充。我们不追求节点数量的数字游戏，更在意每一条上架的线路，是否经得起连续一周的晚高峰。</p>\n    <p>如果你读到这里，说明你也愿意把网络这件事，当成一件需要耐心而非口号的事来对待。那就从这里开始吧。</p>\n  </section>\n</main>\n\n<nav class=\"navbar\" aria-label=\"页面导航\">\n  <span class=\"navbar-brand\">GoCats</span>\n  <div class=\"navbar-links\">\n    <a href=\"#\">方案</a>\n    <a href=\"#\">客户端</a>\n    <a href=\"#\">使用说明</a>\n    <a href=\"#\">常见问题</a>\n    <a href=\"#\">工单</a>\n  </div>\n</nav>",
